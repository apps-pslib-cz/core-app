{
  "hooks": {
    "FileChanged": [
      {
        "matcher": "TASKS.md",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/log-task-status.mjs\" --source claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/log-task-status.mjs\" --source claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
