# Environment variables declared in this file are available at build time and runtime.
# Copy this to .env.local and fill in your values.
# Warning: Never commit .env.local to source control.

# Auth.js (NextAuth v5) Configuration
AUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Duende Identity Server 6 Configuration (shared school OAuth server)
AUTH_DUENDE_IDENTITY_SERVER6_ISSUER=https://your-identity-server.com
AUTH_DUENDE_IDENTITY_SERVER6_ID=your-client-id
AUTH_DUENDE_IDENTITY_SERVER6_SECRET=your-client-secret
# Scope musí obsahovat vlastní scope appky s role-claimy (ROLE_CLAIMS
# v src/types/roles.ts), jinak OAuth server role-claimy nepošle a nikdo
# nedostane žádnou roli. Bez nastavení jen "openid profile email".
AUTH_DUENDE_IDENTITY_SERVER6_SCOPE="openid profile email core"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/your-database?schema=public"

# UI Configuration
NEXT_PUBLIC_TABLE_ROWS_OPTIONS=5,10,15,25,50,100
NEXT_PUBLIC_TABLE_ROWS_DEFAULT=10
NEXT_PUBLIC_AVAILABLE_LANGUAGES=cs,en
NEXT_PUBLIC_DEFAULT_LANGUAGE=cs

# Logging Configuration
LOG_ENABLE_FILE=true
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_SIZE=10
LOG_LEVEL=info

# Analytics (all optional - leave unset to disable; every value below is
# public by nature, visible in page source regardless of being an env var)
# Umami (both required to enable)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Google Analytics (GA4 measurement id, e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
# Microsoft Clarity (project id)
CLARITY_PROJECT_ID=
